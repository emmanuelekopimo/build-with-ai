# ECEWS-ITAMS environment. Copy to .env and adjust. Values are validated at startup
# (src/server/env.ts); Windows line endings (\r) are stripped automatically.

NODE_ENV=development
# Bind to all interfaces so other machines on the LAN can reach the server.
HOST=0.0.0.0
PORT=4000

# --- Database -----------------------------------------------------------------
# Local / Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itams
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/itams
# Neon: DATABASE_URL = the *pooled* connection string (host contains "-pooler"), used by the app.
#       DIRECT_URL   = the *direct* connection string, used by `prisma migrate deploy`.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/itams?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/itams?sslmode=require

# --- Links & sessions -----------------------------------------------------------
# Absolute base URL used in every emailed link (signature, approval, password reset).
# In development this is the Vite URL; in production the server URL, e.g. http://192.168.1.20:4000
APP_BASE_URL=http://localhost:5173
# At least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Idle session timeout in hours.
SESSION_IDLE_HOURS=8
# Secure cookies default to on in production. Set false only when serving production over plain HTTP on a LAN.
# COOKIE_SECURE=false
# Set true when running behind a reverse proxy (so client IPs and rate limits are correct).
TRUST_PROXY=false
# Extra allowed CORS origins (comma-separated). Same-origin needs nothing.
CORS_ORIGINS=

# --- Email ------------------------------------------------------------------------
# smtp | file | memory. "file" writes every email as .eml into MAIL_DIR (development).
MAIL_TRANSPORT=file
MAIL_DIR=var/mail
MAIL_FROM="ECEWS IT Department <it@ecews.org>"
# For Mailpit from docker-compose: MAIL_TRANSPORT=smtp, SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Shown to signers on public pages as the contact for a new link.
IT_CONTACT_EMAIL=it@ecews.org

# --- PDF ------------------------------------------------------------------------
# Path to a Chromium binary for PDF rendering. Leave empty to use Playwright's browsers
# (run `npx playwright install chromium` once if none are installed).
CHROMIUM_PATH=

# --- Misc -------------------------------------------------------------------------
JOBS_ENABLED=true
LOG_LEVEL=info
# Password for users created by `npm run seed`.
SEED_PASSWORD=Itams-Demo-2026
