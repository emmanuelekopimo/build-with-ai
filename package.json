  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bwip-js": "^4.11.4",
    "cookie-parser": "^1.4.7",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright-core": "^1.56.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.56.1",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.53.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^6.30.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"tsx watch --clear-screen=false src/server/index.ts\" \"vite\"",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "prepare": "husky"
  }
}
